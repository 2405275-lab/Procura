# Application Settings
APP_NAME="Procura Backend API"
APP_VERSION="1.0"
APP_ENV="development"

# Security Configurations
SECRET_KEY="supersecretkeyplaceholderforlocalsignings"
JWT_SECRET="jwtsecretkeyplaceholderforlocalsignings"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configurations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procura"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=procura

# Logging Level
LOG_LEVEL="INFO"
